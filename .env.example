# === LLM (Google Vertex AI — service account) ===
# Obligatoire (aucune valeur par défaut dans config.py) — échec explicite au
# boot si absent.
GOOGLE_APPLICATION_CREDENTIALS=credentials/gemini_sa.json
GEMINI_PROJECT=your-gcp-project-id
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash-lite

# === Qdrant ===
# Obligatoire (aucune valeur par défaut dans config.py) — échec explicite au
# boot si absent. http://localhost:6333 en natif, http://qdrant:6333 (nom de
# service) en conteneur (cf. docker-compose.yml).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tickets_resolus
# Pipeline validé techniquement mais retiré du retrieval actif après audit
# (résolutions jugées trop génériques). Voir pipeline FAQ (reclamations_seules).
ENABLE_TICKETS_RESOLUS_COLLECTION=false

# === Embeddings ===
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# === Détection des réclamations redondantes (detect_reclamations_redondantes) ===
# Seuil de similarité cosinus pour regrouper deux réclamations d'un même bucket.
# 0.90 validé sur dry-run réel après nettoyage du bruit d'embedding.
REDUNDANCY_SIMILARITY_THRESHOLD=0.90
# Plancher d'affichage des paires dans le rapport --dry-run.
REDUNDANCY_DRYRUN_FLOOR=0.70
# Troncature (caractères) de message_clean dans la formule d'embedding.
REDUNDANCY_MESSAGE_TRUNCATE=400
# Nombre minimal de tokens informatifs pour être comparé sémantiquement
# (sous ce seuil : singleton_info_faible, jamais comparé).
REDUNDANCY_MIN_INFORMATIVE_TOKENS=4

# === Anonymisation des personnes (NER, cleaning_utils.anonymize_text) ===
# Masque les noms de personnes (entités PER) détectés par spaCy. Filet de
# sécurité actif par défaut — désactiver uniquement si spaCy/le modèle est
# indisponible dans l'environnement (voir check_env.py).
ENABLE_PERSON_ANONYMIZATION=true
PERSON_NER_MODEL=fr_core_news_sm

# === FastAPI ===
# API_HOST/API_PORT retirés (S6) : aucun code ne les lisait ; uvicorn est
# lancé directement en ligne de commande (cf. Dockerfile CMD, --host 0.0.0.0).
API_ENV=development
